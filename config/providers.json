{
  "version": 1,
  "dispatch_lane": {
    "id": "rock-serial",
    "name": "The Rock Serial Gate",
    "concurrency_limit": 1,
    "description": "Durable file queue drained through the circuit-breaker-protected tmux channel."
  },
  "providers": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "type": "claude",
      "transport": "local_tmux",
      "scope": "local",
      "status": "operational",
      "accent": "#b6a2d9",
      "description": "Primary coding brethren for implementation, review, and repository work."
    },
    {
      "id": "codex",
      "name": "Codex",
      "type": "codex",
      "transport": "local_tmux",
      "scope": "local",
      "status": "standby",
      "accent": "#9bc5a4",
      "description": "Codex sessions registered as independent local task executors."
    },
    {
      "id": "hermes",
      "name": "Hermes",
      "type": "hermes",
      "transport": "local_tmux",
      "scope": "local",
      "status": "operational",
      "accent": "#c9a45f",
      "description": "Orchestration, research, and vanguard profiles governed by the serial gate."
    }
  ],
  "agents": [
    {
      "id": "claude-belial",
      "name": "Belial",
