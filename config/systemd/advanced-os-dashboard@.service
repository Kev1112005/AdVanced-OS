[Unit]
Description=AdVanced OS Mission Control
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/AdVanced-OS
Environment=MISSION_CONTROL_PORT=4001
ExecStart=/home/%i/AdVanced-OS/scripts/start-dashboard.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
# Local tmux uses /tmp/tmux-UID for its server socket. Mission Control is a
# trusted local control surface and must share that namespace for Vox/control.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
